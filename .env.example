# Vorlage fuer die lokale Passwort-Datei - NICHT als ".env" in diesen (OneDrive-)Ordner kopieren!
# Lege die echte Datei AUSSERHALB des Projekts ab (z. B. ~/trading-secrets.env, chmod 600) und starte mit
#   docker-compose --env-file ~/trading-secrets.env up -d --build db
# Werte selbst erzeugen, z. B.:  openssl rand -hex 16

# Administrator der Datenbank (nur fuer Einrichtung und Tests, nie fuer die Anwendung)
POSTGRES_PASSWORD=bitte-zufaellig-erzeugen

# Eingeschraenkte Anwendungsrolle "trading_app"
APP_DB_PASSWORD=bitte-zufaellig-erzeugen

# Hier stehen ABSICHTLICH keine Boersen-Schluessel (Coinbase/Bitget).
# Das System verweigert den Start, wenn solche Variablen gesetzt sind. Modus ist immer "paper".
