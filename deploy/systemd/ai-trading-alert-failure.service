# Wird von systemd gestartet, wenn die Sicherung scheitert (OnFailure=) - meldet sofort einen Alarm.
[Unit]
Description=KI-Trading-System - Alarm: Sicherung fehlgeschlagen

[Service]
Type=oneshot
User=trading
Group=trading
EnvironmentFile=/etc/ai-trading/secrets.env
ExecStart=/usr/bin/python3 /opt/ai-trading-system/scripts/ops/alert_check.py --event "Sicherung mit Rueckspiel-Test fehlgeschlagen - Protokoll: journalctl -u ai-trading-backup"
SuccessExitStatus=2
NoNewPrivileges=yes
